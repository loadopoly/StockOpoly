    {
      "id": "efferent.directives",
      "description": "SHA-1 deduplicated body_directives routing across Floor Kanban, Child Hubs, M365 IMMEDIATE_CARD / SHIFT_DIGEST, and auto-closing physical scan feedback.",
      "operations": [
        { "id": "route-directives", "stage": "osq-forecast-unified-control-plane", "mode": "efferent-bridge", "script": "holon/Start-HolonHubLive.ps1", "emits": ["osq.directive.emitted", "osq.directive.autoclosed", "osq.m365.escalation_queued"] }
      ]
