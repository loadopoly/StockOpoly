      "id": "pathway.bifurcation",
      "description": "Deterministic separation of realizations into Systemic ERP configuration levers (R2,R3,R4,R5,R7,R10) vs Operational efferent work orders.",
      "operations": [
        { "id": "classify-pathways", "stage": "osq-governance-gate", "mode": "pathway-router", "script": "holon/Start-HolonHubLive.ps1", "emits": ["osq.pathway.classified"] }
      ]
