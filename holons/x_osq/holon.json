      "operations": [
        { "id": "classify-note", "stage": "osq-quipu-intelligence", "mode": "intelligence-worker", "script": "holon/Start-HolonHubLive.ps1", "emits": ["osq.quipu.note_classified"] }
      ]
    },
    {
