      "operations": [
        { "id": "disposition-return-quarantine", "stage": "osq-by-sap-connector", "mode": "return-chain-gate", "script": "holon/Start-HolonHubLive.ps1", "emits": ["osq.return.quarantine_disposition"] }
      ]
    }
