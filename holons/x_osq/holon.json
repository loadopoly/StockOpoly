        { "id": "governance-gate", "stage": "osq-governance-gate", "mode": "governance-gate", "script": "holon/x_osq.py gate", "emits": ["osq.governance.approved", "osq.emergency_brake.tripped", "osq.approval.requested", "osq.sto.duplicate_blocked"] }
      ]
    },
    {
      "id": "osq.by-transformation",
      "description": "Transform cleansed and governed demand into 26-week Blue Yonder buckets, modular BOM splits, and Weighted Greedy Dijkstra routing across the physical-only Unified Inventory Marketplace.",
      "operations": [
        { "id": "by-transform", "stage": "osq-by-transformation-worker", "mode": "transformation", "script": "holon/x_osq.py transform", "emits": ["osq.blueyonder.transformed", "osq.quote.split_tokenized"] }
      ]
    },
    {
      "id": "osq.integration-connectors",
      "description": "Orchestrate direct SAP/Blue Yonder/IFR/RFID/Stockopoly connectors: IFR auto-PO, cancellation-to-receiving-quarantine, Rust RFID density feedback, Stockopoly bin lookup, and SAP Signal Bridge.",
