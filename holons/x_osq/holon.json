    "skill": "SKILL.md",
    "entrypoint": "holon/x_osq.py",
    "liveEntrypoint": "holon/Start-HolonHubLive.ps1",
    "runtime": "python>=3.9 (stdlib only) + PowerShell 5.1 HolonHubLive HTTP/SSE runtime"
  },
  "hub": {
    "agentSkillFolder": "skills/x-osq"
  },
  "capabilities": [
    {
      "id": "osq.forecast-intake",
      "description": "Ingest and normalize CPQ, Salesforce, SAP, and future forecast sources with accepted-quote eligibility and 6-month horizon gating.",
