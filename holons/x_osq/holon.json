        { "id": "intake-normalize", "stage": "osq-intake-normalizer", "mode": "read-only", "script": "holon/x_osq.py intake", "emits": ["osq.intake.normalized"] }
      ]
    },
    {
      "id": "osq.forecast-cleansing",
      "description": "Direct API time-phased QOH pull & Snowflake transformation retirement: calendar proration, delta detection, and duplicate demand prevention.",
      "operations": [
        { "id": "forecast-cleanse", "stage": "osq-forecast-cleanser", "mode": "transformation", "script": "holon/x_osq.py cleanse", "emits": ["osq.forecast.cleansed", "osq.delta.detected", "osq.inventory.timephased"] }
      ]
    },
    {
      "id": "osq.quipu-intelligence",
      "description": "Engage QUIPU as an intelligent participant worker for confidence scoring, 70%+ over-forecast suppression, SKU substitution, handwritten floor note classification, and lead-time simulation.",
      "operations": [
        { "id": "quipu-curate", "stage": "osq-quipu-intelligence", "mode": "intelligence-worker", "script": "holon/x_osq.py quipu", "emits": ["osq.quipu.curated", "osq.overforecast.suppressed", "osq.sku.substituted", "osq.quipu.note_classified"] }
      ]
    },
    {
      "id": "osq.forecast-governance",
