        { "id": "sync-connectors", "stage": "osq-by-sap-connector", "mode": "connector-sync", "script": "holon/x_osq.py sync", "emits": ["osq.connector.exported", "osq.sap.reservations.synced", "osq.ifr.po_generated", "osq.receiving.quarantine_flagged", "osq.rfid.transit_updated", "osq.sap.signal_dispatched"] },
        { "id": "run-all", "stage": "osq-forecast-unified-control-plane", "mode": "end-to-end-pipeline", "script": "holon/x_osq.py run", "emits": ["osq.pipeline.completed"] }
      ]
    },
    {
