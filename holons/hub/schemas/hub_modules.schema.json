{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hubcore.local/schemas/hub_modules.schema.json",
  "title": "hub_modules.json",
  "description": "Module registry (APP_RECREATION Part 3.2). A module receives no undeclared capability.",
  "type": "object",
  "required": ["schemaVersion", "modules"],
  "properties": {
    "schemaVersion": { "const": 10 },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["manifestVersion", "moduleId", "name", "version", "entrypoint", "chainId", "capabilities"],
        "properties": {
          "manifestVersion": { "const": 2 },
          "moduleId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$" },
          "name": { "type": "string" },
          "version": { "type": "string" },
          "entrypoint": { "type": "string" },
          "chainId": { "type": "string" },
          "enabled": { "type": "boolean" },
          "endpointRef": { "type": "string" },
          "capabilities": {
            "type": "array",
            "items": {
              "enum": ["dashboard", "data.read", "data.export", "vector.search", "comms", "ask",
                       "ocr.capture", "metrology.touch", "observer.read", "observer.feedback", "blob.write"]
            }
          },
          "dataContracts": { "type": "array" },
          "permissions": { "type": "array" },
          "integrity": {
            "type": "object",
            "properties": {
              "sha256": { "type": "string" },
              "signatureRef": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
