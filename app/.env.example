# StockOpoly app environment (Vite). Copy to .env.local for dev.
# All optional — the app builds and runs with none of these set.

# Supabase — point at the SAME project the Loadopoly Operate Console uses so the
# hosted app reads what the engine mirrors. These are inlined into the public
# bundle; rely on RLS (see engine/sql/supabase_schema.sql), not secrecy.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: when the static app is hosted away from the engine (e.g. GitHub
# Pages), point it at a reachable engine API. Blank = same-origin (the engine
# serves the built UI, or the dev server proxies /api).
VITE_ENGINE_URL=

# Optional: base path. GitHub Pages project sites need "/StockOpoly/"; the
# deploy workflow sets this automatically. Default "/" for local/engine-served.
VITE_BASE=/
